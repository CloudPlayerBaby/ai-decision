# 复制为 .env 后填写本地值（.env 勿提交仓库）
# cp .env.example .env

DEEPSEEK_API_KEY=your_deepseek_api_key

# 与 docker-compose 中 MySQL root 密码保持一致
MYSQL_ROOT_PASSWORD=1234
DB_USERNAME=root
DB_PASSWORD=1234
DB_URL=jdbc:mysql://127.0.0.1:3308/ai_decision?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai

# Redis（LangGraph4j Checkpoint 持久化 + 缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1234

# Tavily Search API 密钥
TAVILY_API_KEY=tvly-your_tavily_api_key_here
